# Docker Compose PostgreSQL (bfms-postgres)
# Host port 5433 → container 5432, so Windows PostgreSQL 17 can keep 5432.
# Use this file when Docker Desktop / WSL is working:
#   copy .env.docker .env
#   docker compose up -d postgres

POSTGRES_USER=bfms
POSTGRES_PASSWORD=bfms_dev_password
POSTGRES_DB=bfms
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://bfms:bfms_dev_password@localhost:5433/bfms

API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-in-production-use-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200
