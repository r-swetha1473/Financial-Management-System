# Direct (IPv6): postgresql+asyncpg://postgres:PASSWORD@db.vtprqttqzcqtdbwzmtmi.supabase.co:5432/postgres?ssl=require
# Vercel (IPv4 pooler): postgresql+asyncpg://postgres.vtprqttqzcqtdbwzmtmi:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?ssl=require
