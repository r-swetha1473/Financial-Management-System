# PostgreSQL — local development (native Windows PostgreSQL 17 on localhost:5432)
POSTGRES_USER=bfms
POSTGRES_PASSWORD=bfms_dev_password
POSTGRES_DB=bfms
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://bfms:bfms_dev_password@localhost:5432/bfms

# Docker Compose PostgreSQL (optional; host port 5433) — saved in .env.docker
# POSTGRES_PORT=5433
# DATABASE_URL=postgresql+asyncpg://bfms:bfms_dev_password@localhost:5433/bfms

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-in-production-use-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:4200

# Frontend (development)
FRONTEND_URL=http://localhost:4200

# --- Production (set in Vercel; never commit real values) ---
